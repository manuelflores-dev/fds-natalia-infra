# ── Configuración de Contenedores ──────────────────────────────────────────────
PHP_API_CONTAINER=natalia_api
PHP_WEB_CONTAINER=natalia_web
NGINX_CONTAINER=natalia_nginx
MARIADB_CONTAINER=natalia_db
REDIS_CONTAINER=natalia_redis

# ── Base de datos (una sola, compartida por la API y la web) ───────────────────
DB_DATABASE=natalia
DB_USERNAME=natalia
DB_PASSWORD=cambiame
DB_ROOT_PASSWORD=cambiame_tambien

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cambiame_igual

# ── Red ──────────────────────────────────────────────────────────────────────
DOCKER_NETWORK_NAME=natalia_app_network


# ── Puertos publicados en el host (solo en 127.0.0.1) ─────────────────────────
# Nginx NO usa el 80/443: esos los tiene el nginx reverse proxy del host
# (repo fds-server-proxy), que manda aquí los dominios de pastelería.
NGINX_PORT=8082
MARIADB_PORT=33062
